# ===================
# AI BACKEND
# ===================

# "openrouter" (default) or "anthropic"
AI_BACKEND=openrouter

# OpenRouter - get a key at https://openrouter.ai/keys
OPENROUTER_API_KEYS=sk-or-v1-your-key-here

# Anthropic - get a key at https://console.anthropic.com/settings/keys
# Only needed if AI_BACKEND=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model for image analysis
# OpenRouter format: anthropic/claude-sonnet-4-20250514
# Anthropic format:  claude-sonnet-4-20250514
AI_MODEL=anthropic/claude-sonnet-4-20250514

# ===================
# ALERTS
# ===================

RESEND_API_KEY=re_your_key_here
FROM_EMAIL=alerts@yourdomain.com
TO_EMAIL=your@email.com

# Facebook cookies - see README for how to get these
FB_COOKIES=[{"name":"datr","value":"xxx","domain":".facebook.com","path":"/"},{"name":"sb","value":"xxx","domain":".facebook.com","path":"/"},{"name":"c_user","value":"xxx","domain":".facebook.com","path":"/"},{"name":"xs","value":"xxx","domain":".facebook.com","path":"/"},{"name":"fr","value":"xxx","domain":".facebook.com","path":"/"},{"name":"locale","value":"en_GB","domain":".facebook.com","path":"/"}]

# ===================
# LOCATION
# ===================

# City slug(s) from facebook.com/marketplace/SLUG/search
# Comma-separated for multiple cities
MARKETPLACE_LOCATIONS=nyc

TIMEZONE=America/New_York
LATITUDE=40.7128
LONGITUDE=-74.0060
LOCALE=en-US

# ===================
# SCHEDULER
# ===================

RUNS_PER_DAY=12
START_HOUR=9
END_HOUR=2

# ===================
# SCRAPING
# ===================

# Minimum deal score to alert (0-10, 0 = all finds)
MIN_DEAL_SCORE=0

# Listings to check per run
LISTING_COUNT=20

# true = invisible browser, false = show window, auto = detect
HEADLESS=auto
